# Copy this file to .env and fill in the values you need.
# Every key here is documented in README.md under "Configuration (.env)".

MODEL_SIZE=medium
LANGUAGE=vi
CHUNK_TARGET_SECONDS=300
CHUNK_MIN_SECONDS=120
CHUNK_MAX_SECONDS=420
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION=0.5
KEEP_TEMP_FILES=false

# Optional: comma-separated words/phrases (or a sample sentence) that hints
# Whisper toward correct spelling of domain-specific terms, names, jargon.
# Also given as context to the transcript-correction step, if ANTHROPIC_API_KEY is set.
DOMAIN_VOCABULARY=

# Whisper segments scoring below this confidence get flagged in the output.
CONFIDENCE_THRESHOLD=-1.0

# Optional: HuggingFace token - enables speaker diarization AND speaker
# recognition (who said what + matching against enrolled voices). Leave
# empty to skip both. See README.md "Getting a HuggingFace token".
HUGGINGFACE_TOKEN=

# Optional: Anthropic API key + model - enables two independent steps:
# transcript correction (fixes likely mis-transcribed words using context)
# and automatic topic segmentation. Leave the key empty to skip both.
# See README.md "Getting an Anthropic API key".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Max transcript lines sent to Claude per transcript-correction call. Only
# matters for long videos - a real failure on a ~2 hour video showed one
# call for the whole transcript can silently fail (see CODE_REVIEW.md).
# Lower this if correction still fails on a very long video; the default
# comfortably covers multi-hour recordings.
CORRECTION_BATCH_SIZE=150

# Optional: where the enrolled speaker-voice database lives. Leave empty to
# use the default (data/speaker_profiles.json in the project root).
SPEAKER_PROFILES_PATH=

# Cosine-similarity threshold (0-1) for recognizing an enrolled speaker.
# Higher = stricter (fewer false matches, more "Speaker N" fallbacks).
SPEAKER_MATCH_THRESHOLD=0.75

# If true, a confident match also refines that speaker's stored profile
# with the new sample. Leave false until you trust the matches you are getting.
AUTO_UPDATE_SPEAKER_PROFILES=false

# --- process/batch.py (multi-video batch runner) --------------------------
# See README.md "Batch processing many videos" for the full picture.

# Folder to scan recursively for videos (.mp4/.mov/.mkv/.avi/.webm). Leave
# empty and batch.py does nothing - main.py's GUI is unaffected either way.
INPUT_DIR=

# How many seconds of video each parallel ffmpeg worker extracts at once
# for a long video (see "Faster audio extraction" below). Only kicks in
# past a length where parallelizing is actually worth it.
EXTRACT_CHUNK_SECONDS=600

# Max number of parallel ffmpeg extraction workers. Keep this at or below
# your CPU's core count - more workers than cores just adds contention.
EXTRACT_MAX_WORKERS=4

# Optional: override where batch.py's progress table, lock file, and logs
# live. Leave empty to use the defaults (state/, state/.batch.lock, logs/
# under the project root).
STATE_PATH=
LOCK_PATH=
LOG_DIR=
