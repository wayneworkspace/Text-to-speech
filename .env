MODEL_SIZE=medium
LANGUAGE=vi
CHUNK_TARGET_SECONDS=300
CHUNK_MIN_SECONDS=120
CHUNK_MAX_SECONDS=420
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION=0.5
KEEP_TEMP_FILES=false

# Optional: comma-separated words/phrases (or a sample sentence) that hints
# Whisper toward correct spelling of domain-specific terms, names, jargon.
DOMAIN_VOCABULARY=

# Whisper segments scoring below this confidence get flagged in the output.
CONFIDENCE_THRESHOLD=-1.0

# Optional: HuggingFace token, needed for speaker diarization (who said what).
# Leave empty to skip diarization. See README.md "Getting a HuggingFace token".
HUGGINGFACE_TOKEN=

# Optional: Anthropic API key + model, needed for topic segmentation.
# Leave the key empty to skip topic segmentation. See README.md "Getting an
# Anthropic API key".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
